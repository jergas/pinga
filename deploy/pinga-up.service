[Unit]
Description=Bring up the pinga tmux session and reconcile agent windows after boot
After=network.target opencode.service pinga-tmux-restore.service

[Service]
Type=oneshot
# NixOS: user units get a minimal PATH without /run/current-system/sw/bin
# (tmux lives there). Keep the standard dirs + the user bin dir.
Environment=PATH=/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:%h/.local/bin
ExecStart=%h/.local/bin/pinga up

[Install]
WantedBy=default.target